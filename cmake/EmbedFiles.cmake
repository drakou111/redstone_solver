# Generates a C++ source embedding every file under INPUT_DIR.
# Usage: cmake -DINPUT_DIR=<dir> -DOUTPUT=<file.cpp> -P EmbedFiles.cmake

if (NOT INPUT_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "INPUT_DIR and OUTPUT are required")
endif ()
if (NOT EXISTS "${INPUT_DIR}/index.html")
    message(FATAL_ERROR "${INPUT_DIR}/index.html not found; build the web UI first")
endif ()

file(GLOB_RECURSE files RELATIVE "${INPUT_DIR}" "${INPUT_DIR}/*")
list(SORT files)

set(arrays "")
set(entries "")
set(index 0)
foreach (relative IN LISTS files)
    file(READ "${INPUT_DIR}/${relative}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(([^,]*,){32})" "\\1\n" bytes "${bytes}")
    string(APPEND arrays "const unsigned char file_${index}[] = {\n${bytes}0};\n")

    get_filename_component(extension "${relative}" LAST_EXT)
    set(mime "application/octet-stream")
    if (extension STREQUAL ".html")
        set(mime "text/html; charset=utf-8")
    elseif (extension STREQUAL ".js")
        set(mime "text/javascript; charset=utf-8")
    elseif (extension STREQUAL ".css")
        set(mime "text/css; charset=utf-8")
    elseif (extension STREQUAL ".svg")
        set(mime "image/svg+xml")
    elseif (extension STREQUAL ".png")
        set(mime "image/png")
    elseif (extension STREQUAL ".woff2")
        set(mime "font/woff2")
    endif ()
    file(SIZE "${INPUT_DIR}/${relative}" size)
    string(APPEND entries "    {\"/${relative}\", \"${mime}\", file_${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach ()

file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/EmbedFiles.cmake. Do not edit.
#include \"host/embedded_files.hpp\"

namespace rs::host {

namespace {
${arrays}
const EmbeddedFile kFiles[] = {
${entries}};
} // namespace

std::span<const EmbeddedFile> embedded_files() { return kFiles; }

} // namespace rs::host
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
